source "https://rubygems.org"

gem "jekyll", "~> 4.3"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-scholar"   # citações/bibliografia — precisa de build via GitHub Actions (não é suportado pelo build automático do GitHub Pages)
end

# servidor local (necessário em algumas versões do Ruby)
gem "webrick"
